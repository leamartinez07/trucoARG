{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": { "api/game.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/((?!api/|assets/|cards/|favicon.svg).*)", "destination": "/index.html" }]
}
